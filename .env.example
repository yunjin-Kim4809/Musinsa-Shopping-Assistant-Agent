# 이 파일을 복사해서 .env 로 저장한 뒤 실제 키를 채워주세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 git에 올라가지 않습니다.

# Tavily API 키 (필수) - https://tavily.com 에서 발급
TAVILY_API_KEY=

# OpenAI API 키 (선택) - LLM 기반 추천 이유 생성에 사용. 없으면 휴리스틱으로 대체됩니다.
OPENAI_API_KEY=

# --- 아래는 선택적 튜닝 값 (기본값으로 충분) ---
# 검색 결과 캐시 TTL(초) / 최대 엔트리 수
# CACHE_TTL_SECONDS=300
# CACHE_MAX_SIZE=256

# 토큰 버킷 rate limiter: 초당 리필 속도 / 버킷 용량
# RATE_LIMIT_PER_SECOND=5.0
# RATE_LIMIT_BURST=10

# 서킷 브레이커: 연속 실패 임계값 / OPEN 유지 시간(초)
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_RECOVERY_TIMEOUT=30.0

# 검색 병렬화 스레드 수
# SEARCH_MAX_WORKERS=4
